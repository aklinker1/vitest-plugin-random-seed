{
  "name": "vitest-plugin-random-seed",
  "version": "2.0.1",
  "keywords": [
    "chance",
    "faker",
    "falso",
    "random",
    "seed",
    "test",
    "vitest"
  ],
  "homepage": "https://github.com/aklinker1/vitest-plugin-random-seed",
  "license": "MIT",
  "author": {
    "name": "Aaron Klinker",
    "email": "aaronklinker1+npm@gmail.com"
  },
  "repository": {
    "url": "https://github.com/aklinker1/vitest-plugin-random-seed"
  },
  "files": [
    "dist",
    "src/types.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./src/types.d.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "build": "tsdown src/index.ts --dts.tsgo",
    "prepack": "bun run build",
    "check": "check",
    "prepublish": "bun run build"
  },
  "dependencies": {
    "@aklinker1/zero-factory": "^1.2.1"
  },
  "devDependencies": {
    "@aklinker1/check": "^2.4.0",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "publint": "^0.3.21",
    "simple-git-hooks": "^2.10.0",
    "tsdown": "^0.22.4",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "vite": ">=4"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged"
  },
  "nano-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "bun": "*",
    "deno": "*",
    "node": "*"
  }
}
